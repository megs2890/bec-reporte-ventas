# InterFuerza (el token se crea en Configuracion > Apps > InterFuerza API)
IFX_TOKEN=
# Clave para entrar al reporte y secreto de sesion (cadena larga al azar)
REPORT_PASSWORD=
SESSION_SECRET=
# Donde vive la base de datos. En Railway: monta un volumen en /data
DATA_DIR=/data
# Direccion publica del servicio (para el enlace del correo)
PUBLIC_URL=https://tu-servicio.up.railway.app
# Programacion diaria (hora de Panama)
SYNC_HOUR=7
SYNC_MINUTE=0
SYNC_DAYS_BACK=5
# Correo diario: "resend" (recomendado en Railway) o "smtp"
# Correo diario. Con Gmail: smtp + contrasena de aplicacion (Railway exige plan Pro para SMTP).
EMAIL_PROVIDER=smtp
EMAIL_FROM=Reporte de Ventas - PANAMA BEC <tucuenta@gmail.com>
EMAIL_TO=
# Avisos de falla y correo de prueba (no va a los directores)
EMAIL_AVISOS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
