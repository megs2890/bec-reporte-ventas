# InterFuerza (el token se crea en Configuracion > Apps > InterFuerza API)
IFX_TOKEN=
# Clave para entrar al reporte y secreto de sesion (cadena larga al azar)
REPORT_PASSWORD=
SESSION_SECRET=
# Donde vive la base de datos. En Railway: monta un volumen en /data
DATA_DIR=/data
# Direccion publica del servicio (para el enlace del correo)
PUBLIC_URL=https://tu-servicio.up.railway.app
# Programacion diaria (hora de Panama)
SYNC_HOUR=7
SYNC_MINUTE=0
SYNC_DAYS_BACK=5
# Correo diario: "resend" (recomendado en Railway) o "smtp"
EMAIL_PROVIDER=resend
EMAIL_FROM=Reporte BEC <reportes@tudominio.com>
EMAIL_TO=director1@ejemplo.com,director2@ejemplo.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
